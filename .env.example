# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/legaldocs

# Redis
REDIS_URL=redis://redis:6379/0

# Certificate paths
CA_CERT_PATH=/certs/ca.crt
ENCLAVE_CERT_PATH=/certs/enclave.crt
ENCLAVE_KEY_PATH=/certs/enclave.key
PARENT_CERT_PATH=/certs/parent.crt
PARENT_KEY_PATH=/certs/parent.key

# Ethereum / Blockchain
ETH_RPC_URL=http://ganache:8545
# Optional: set a specific contract address (auto-deploys if empty)
REGISTRY_CONTRACT_ADDRESS=
# Optional: private key for signing transactions (uses ganache account[0] if empty)
ETH_PRIVATE_KEY=
